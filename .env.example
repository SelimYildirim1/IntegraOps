# Generate actual local secrets with: python3 scripts/init_local.py
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
BOOTSTRAP_KEY=
POSTGRES_PORT=54329
RABBITMQ_PORT=56729
RABBITMQ_MANAGEMENT_PORT=15679
API_PORT=8080

# Kurumsal (Aşama 13): sistem yöneticisi e-postaları (virgülle), kendi kendine kayıt ve SSO geri dönüş adresi
SYSTEM_ADMIN_EMAILS=
SIGNUP_ENABLED=true
API_PUBLIC_URL=http://127.0.0.1:8080

# Yapay zekâ (docs/yapay-zeka.md). none = kapalı, fake = yerel doğrulama, gemini = Gemini ücretsiz deneme profili
# (IntegraOps_Gemini_Ucretsiz_Test_Rehberi.md). Anahtar yalnızca bu dosyada/sunucu ortamında durur; Git'e ve panele girmez.
AI_PROVIDER=none
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# AI Studio'da anahtarın projesinin Free Tier olduğunu doğruladıktan sonra true yapın; billing garantisi değil, kayıtlı kontrol işaretidir.
AI_FREE_TIER_CONFIRMED=false
AI_FREE_TIER_ONLY=true
# Deneme profili: yalnızca TEST- ile başlayan sentetik işlemler sağlayıcıya gider; production ortamında açılmaz.
AI_TEST_MODE=true
AI_ENABLED=true
# Rehberdeki deneme sınırları (Google kotası değil, uygulama sınırı)
AI_DAILY_LIMIT=10
AI_MAX_OUTPUT_TOKENS=800
AI_TIMEOUT_SECONDS=30
AI_MAX_CONCURRENT_REQUESTS=1
AI_MIN_SECONDS_BETWEEN_REQUESTS=60
AI_MAX_REQUEST_BYTES=12000
AI_CACHE_TTL_SECONDS=300
