-- Example source query for the ERP order → invoice flow. $1 and $2 are the window bounds (timestamptz).
-- Return one row per transaction, or one row per completed step.
SELECT o.order_no                         AS transaction_id,
       o.created_at                       AS occurred_at,
       'order-created'                    AS step_code,
       'completed'                        AS step_status,
       o.created_at                       AS step_at
FROM erp.orders o
WHERE o.created_at >= $1 AND o.created_at < $2
UNION ALL
SELECT o.order_no, o.created_at, 'invoice-created', 'completed', i.issued_at
FROM erp.orders o JOIN erp.invoices i ON i.order_id = o.id
WHERE o.created_at >= $1 AND o.created_at < $2;
