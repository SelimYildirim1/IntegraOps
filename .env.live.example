# Copy to .env.live on the live host only (chmod 600). Never commit .env.live.
# Generate secrets with: python3 -c "import secrets;print(secrets.token_hex(32))"

# --- Release ---
# Registry path that holds api, worker and panel images (see .github/workflows/release.yml).
IMAGE_REGISTRY=ghcr.io/selimyildirim1/integraops
# Set by scripts/live/deploy.sh; do not edit by hand.
IMAGE_TAG=
COMPOSE_PROJECT_NAME=integraops-live
DEPLOYMENT_ENVIRONMENT=production

# --- Secrets ---
POSTGRES_PASSWORD=replace_with_48_hex_characters
RABBITMQ_PASSWORD=replace_with_48_hex_characters
BOOTSTRAP_KEY=replace_with_64_hex_characters
GRAFANA_ADMIN_PASSWORD=replace_with_32_characters

# --- Public addresses (DNS A/AAAA records must point to this host before first start) ---
PANEL_HOST=panel.example.com
API_HOST=api.example.com
HTTP_PORT=80
HTTPS_PORT=443

# --- Real notification targets; keep them separate from test targets ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM=notifications@example.com
SMTP_USER=replace_me
SMTP_PASSWORD=replace_me
# Comma-separated HTTPS origins allowed as webhook targets, e.g. https://hooks.example.com
WEBHOOK_ORIGINS=

# --- Operations alerts (Alertmanager) ---
# Team mailbox for IntegraOps' own health alerts. Use a different address than customer alarm channels.
OPS_ALERT_EMAIL=ops@example.com
# Optional: HTTPS webhook (for example a chat integration) that receives the same alerts.
OPS_ALERT_WEBHOOK_URL=

# --- State and backups ---
# Host directory for backups, backup metrics and rendered configuration.
LIVE_STATE_DIR=/var/lib/integraops
BACKUP_KEEP_DAYS=14
# rclone remote path OUTSIDE this server, e.g. "b2:integraops-backups/prod" or "s3:bucket/prod".
# Configure the remote in LIVE_STATE_DIR/rclone/rclone.conf. Empty disables off-site copy (not allowed for production).
BACKUP_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=90

# Kurumsal (Aşama 13)
SYSTEM_ADMIN_EMAILS=
SIGNUP_ENABLED=false

# Ölçek (Aşama 14): kopya sayıları; docs/olcek.md ölçüm sonucuna göre artırılır
API_REPLICAS=1
WORKER_REPLICAS=1
